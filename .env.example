# Copy these into Vercel: Project, Settings, Environment Variables. Never commit real values.

# Base of the published Google Sheet (File, Share, Publish to web). Looks like:
# https://docs.google.com/spreadsheets/d/e/2PACX-xxxxxxxx/pub
SHEET_PUB_BASE=

# Google AI Studio API key (free tier) for the chatbot. Server side only.
GEMINI_API_KEY=

# Optional
GEMINI_MODEL=gemini-2.5-flash
# Extra domains allowed to call /api/chat, comma separated (your own domain is always allowed)
ALLOWED_ORIGINS=
# Questions per IP per 10 minutes, and per day per server instance
CHAT_LIMIT_PER_IP=8
CHAT_LIMIT_PER_DAY=250
